{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/fw.mjs doctor:*)",
      "Bash(node scripts/fw.mjs ports:*)",
      "Bash(node scripts/fw.mjs gen:*)",
      "Bash(node scripts/fw.mjs select:*)",
      "Bash(node scripts/fw.mjs compile:*)",
      "Bash(node scripts/fw.mjs monitor:*)",
      "Bash(node scripts/fw.mjs log:*)",
      "Bash(node scripts/gen-catalog.mjs:*)",
      "Bash(node server/scripts/mqtt-tail.mjs:*)",
      "Bash(mosquitto_sub:*)",
      "PowerShell(node scripts/fw.mjs doctor:*)",
      "PowerShell(node scripts/fw.mjs ports:*)",
      "PowerShell(node scripts/fw.mjs gen:*)",
      "PowerShell(node scripts/fw.mjs select:*)",
      "PowerShell(node scripts/fw.mjs compile:*)",
      "PowerShell(node scripts/fw.mjs monitor:*)",
      "PowerShell(node scripts/fw.mjs log:*)"
    ],
    "ask": [
      "Bash(node scripts/fw.mjs upload:*)",
      "Bash(node scripts/fw.mjs selftest:*)",
      "Bash(mosquitto_pub:*)",
      "Bash(*arduino-cli*upload*)",
      "PowerShell(node scripts/fw.mjs upload:*)",
      "PowerShell(node scripts/fw.mjs selftest:*)",
      "PowerShell(*arduino-cli*upload*)"
    ],
    "deny": [
      "Read(./firmware/**/secrets.h)",
      "Read(./server/.env)",
      "Read(./server/.env.local)",
      "Read(./server/.env.development)",
      "Read(./server/.env.production)",
      "Read(./server/.env.test)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(./firmware/**/secrets.h)",
      "Edit(./server/.env)",
      "Edit(./server/.env.local)",
      "Edit(./server/.env.development)",
      "Edit(./server/.env.production)",
      "Edit(./server/.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-secrets.mjs\""
          }
        ]
      }
    ]
  }
}
