# Copy to RAG/.env and fill in. RAG/.env is ignored by git; never commit a real key.
GEMINI_API_KEY=

# Models (defaults shown)
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=3072

# Quota ceilings, deliberately below the real limits (15 RPM / 500 RPD and 100 RPM / 30k TPM / 1000 RPD)
GEMINI_GENERATION_RPM_LIMIT=10
GEMINI_GENERATION_RPD_LIMIT=350
GEMINI_EMBEDDING_RPM_LIMIT=80
GEMINI_EMBEDDING_TPM_LIMIT=24000
GEMINI_EMBEDDING_RPD_LIMIT=800
GEMINI_MAX_RETRIES=4

# Retrieval
RAG_CONTEXT_TOP_K=6
RAG_CONTEXT_TOP_K_DIAGNOSTIC=8
