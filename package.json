{
  "name": "cognitive-dataops",
  "version": "0.1.0",
  "private": true,
  "description": "Cognitive DataOps — Agentic Contextualization of Edge Telemetry for Digital Twins. Enterprise-grade digital twin asset pipeline and spatial sensor-mapping platform.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c red,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
