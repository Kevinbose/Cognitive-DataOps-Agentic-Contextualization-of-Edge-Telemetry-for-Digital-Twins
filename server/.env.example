# ─────────────────────────────────────────────────────────────────────────────
# Cognitive DataOps — server environment template
#
# Copy this file to `server/.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is committed as the contract.
#   cp server/.env.example server/.env      (macOS / Linux)
#   Copy-Item server\.env.example server\.env   (Windows PowerShell)
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB
#
# Recommended: a shared MongoDB Atlas free-tier (M0) cluster so all three
# teammates hit the same database with zero local install.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cognitive_dataops
#
# Atlas M0 is a replica set, so multi-document TRANSACTIONS work out of the box
# (the sensor-binding rebind flow uses one). A bare local `mongod` standalone
# does NOT support transactions — the service degrades gracefully with a warning,
# but Atlas (or a local replica set) is strongly preferred. See README.
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/cognitive_dataops

# ─────────────────────────────────────────────────────────────────────────────
# Asset storage (local filesystem "S3-mimic" bucket root)
#
# Absolute path, or relative to the repository root. Leave as-is to use the
# committed `storage/` directory at the repo root.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_ROOT=storage

# Comma-separated list of browser origins allowed to call this API.
# The Vite dev server defaults to 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload size ceilings in megabytes.
# Defaults give headroom over the largest known sample files:
#   mwp001-layout.stp  = 19.85 MB   -> 25 MB cap
#   machine_shop.glb   =  7.92 MB   -> 50 MB cap
MAX_CAD_UPLOAD_MB=25
MAX_GLB_UPLOAD_MB=50

# ─────────────────────────────────────────────────────────────────────────────
# Network binding
#
# Loopback by default. There is no authentication yet, so the API must not be
# reachable from the rest of the network. Set HOST=0.0.0.0 only on a network you
# trust, for example to reach the API from a phone during a demo.
# ─────────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# Telemetry ingestion (Phase 3)
#
# Ingestion starts ONLY when MQTT_URL is set, so a teammate without broker
# access still runs Phases 1 and 2 untouched.
#
#   Local development (Mosquitto on this machine, simulator publishing):
#     MQTT_URL=mqtt://127.0.0.1:1883
#   HiveMQ Cloud (the two ESP32 boards):
#     MQTT_URL=mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883
#
# The URL must NOT contain credentials; put them in the two variables below.
# `.env` is gitignored, so real values stay on this machine.
#
# Two single-writer rules:
#   - Only ONE backend per database may run with TELEMETRY_PERSIST=true, because
#     a time-series collection cannot reject duplicates.
#   - Only ONE backend at a time should subscribe to the cloud broker; three
#     subscribers would use the free plan's 10 GB monthly quota. Teammates use
#     local Mosquitto plus `node server/scripts/simulate-devices.mjs`.
# ─────────────────────────────────────────────────────────────────────────────
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_SITE_ID=vit-lab

# Write samples to MongoDB (time-series collections, one sample per channel per second).
TELEMETRY_PERSIST=true
TELEMETRY_PERSIST_HZ=1
# Stored telemetry expires after this many hours (TTL index / collMod).
TELEMETRY_RETENTION_HOURS=48
# Most websocket batches per second sent to browsers.
TELEMETRY_EMIT_HZ_MAX=10
# Most documents held in memory while MongoDB is slow or away; oldest dropped first.
TELEMETRY_BUFFER_MAX=20000

# Fault-injection commands (scenario, interval, reboot, ping) sent to devices.
# Off by default because a command can reboot a machine. The demo turns it on.
ENABLE_DEVICE_COMMANDS=false
# Minimum gap between two commands to the same device, in ms. 0 disables the limit.
COMMAND_MIN_INTERVAL_MS=2000
